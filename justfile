# SPDX-License-Identifier: GPL-2.0-or-later
# justfile -- fritz-guest task runner. https://just.systems
#
#   just                  # list recipes
#   just test             # host protocol tests (ASan/UBSan) + LuCI contract
#   just test-kernel      # rootless netns kernel data-plane test (needs the SDK's libmnl)
#   just package-build    # both .apk packages via the OpenWrt SDK into dist/

set shell := ["sh", "-cu"]

# OpenWrt target defaults (reference device: mediatek/filogic, aarch64_cortex-a53);
# override per invocation:  just package-build target=x86/64
target       := "mediatek/filogic"
owrt_version := "25.12.5"
sdk_dir      := "sdks"
out_dir      := "dist"
build_dir    := "build"
packages     := "fritz-guest luci-app-fritz-guest"
# Libraries the daemon links against; installed from the SDK's base feed.
feed_libs    := "libubox ubus uci libmnl"

# List available recipes.
default:
    @just --list

# Host-only suites: protocol/state machine (sanitized) and LuCI contract.
test: test-protocol test-luci

# Codec, reliable transport, FSM and UCI validation under ASan/UBSan.
test-protocol:
    mkdir -p {{build_dir}}/sanitize
    ${CC:-cc} -std=c11 -D_GNU_SOURCE -Wall -Wextra -Werror -g -O1 \
        -fsanitize=address,undefined -fno-sanitize-recover=all \
        -Isrc -o {{build_dir}}/sanitize/protocol-test \
        tests/protocol-test.c src/proto.c src/ctrl.c src/config.c
    {{build_dir}}/sanitize/protocol-test

# Offline LuCI view contract (mocked LuCI APIs); skipped without Node.js.
test-luci:
    #!/bin/sh
    if command -v node >/dev/null; then node tests/luci-contract.js
    else echo "SKIP test-luci: node not installed"; fi

# Kernel integration in a throwaway user+network namespace (no root needed).
# Uses libmnl sources from the project SDK's dl/ (run package-build once first).
test-kernel:
    #!/bin/sh
    set -eu
    t="$(echo '{{target}}' | tr '/' '-')"
    sdk="{{sdk_dir}}/openwrt-sdk-{{owrt_version}}-${t}_gcc-${gcc_ver:-14.3.0}_musl.Linux-x86_64"
    tarball="$(ls "$sdk"/dl/libmnl-*.tar.* 2>/dev/null | head -1)" || true
    [ -n "$tarball" ] || { echo "no libmnl source in $sdk/dl -- run 'just package-build' first"; exit 2; }
    out="{{build_dir}}/kernel"
    rm -rf "$out" && mkdir -p "$out/libmnl"
    tar -xf "$tarball" -C "$out/libmnl" --strip-components=1
    : > "$out/libmnl/src/config.h"   # normally generated by autoconf; nothing needed
    for f in "$out"/libmnl/src/*.c; do
        ${CC:-cc} -c -w -O1 -I"$out/libmnl/include" -o "${f%.c}.o" "$f"
    done
    ${CC:-cc} -std=c11 -D_GNU_SOURCE -Wall -Wextra -Werror -g -O1 -fsanitize=address,undefined \
        -Isrc -I"$out/libmnl/include" -o "$out/kernel-test" \
        tests/kernel-test.c src/linux.c src/proto.c "$out"/libmnl/src/*.o
    unshare -rn "$out/kernel-test"

# Syntax/format checks for shell, JSON and package metadata.
check:
    #!/bin/sh
    rc=0
    for f in package/fritz-guest/files/etc/init.d/fritz-guest; do
        if sh -n "$f"; then echo "OK   $f"; else echo "ERR  $f"; rc=1; fi
    done
    for f in package/luci-app-fritz-guest/root/usr/share/luci/menu.d/*.json \
             package/luci-app-fritz-guest/root/usr/share/rpcd/acl.d/*.json; do
        if python3 -m json.tool "$f" >/dev/null; then echo "OK   $f"; else echo "ERR  $f"; rc=1; fi
    done
    exit $rc

# Download + extract the OpenWrt SDK for the target into sdks/ (idempotent).
sdk-download target=target:
    #!/bin/sh
    set -u
    t="$(echo '{{target}}' | tr '/' '-')"
    d="{{sdk_dir}}/openwrt-sdk-{{owrt_version}}-${t}_gcc-${gcc_ver:-14.3.0}_musl.Linux-x86_64"
    if [ ! -f "$d/rules.mk" ]; then
        mkdir -p "{{sdk_dir}}"
        # resolve the exact filename from the listing: the gcc version can drift
        idx="https://downloads.openwrt.org/releases/{{owrt_version}}/targets/{{target}}/"
        f="$( { command -v curl >/dev/null && curl -fsSL "$idx" || wget -qO- "$idx"; } \
              | grep -oE "openwrt-sdk-[0-9.]+-${t}[^\"']*\.tar\.zst" | sort -u | head -1 )"
        [ -n "$f" ] || { echo "no sdk tarball found in $idx"; exit 1; }
        tmp="{{sdk_dir}}/.sdk-$$.tar.zst"
        echo "downloading $idx$f" >&2
        if command -v curl >/dev/null; then curl -fSL -o "$tmp" "$idx$f"; else wget -q -O "$tmp" "$idx$f"; fi || \
            { echo "download failed"; rm -f "$tmp"; exit 1; }
        unzstd -c "$tmp" | tar -x -C "{{sdk_dir}}" || { echo "extract failed"; rm -f "$tmp"; exit 1; }
        rm -f "$tmp"
        [ -f "$d/rules.mk" ] || { echo "extract produced no $d"; exit 1; }
    fi
    # one-time prep: base feed for the linked libraries, then a config that
    # never drops into menuconfig
    if [ ! -e "$d/package/feeds/base/libubox" ]; then
        "$d"/scripts/feeds update base >/dev/null 2>&1 || { echo "feeds update failed"; exit 1; }
        "$d"/scripts/feeds install {{feed_libs}} >/dev/null 2>&1 || { echo "feeds install failed"; exit 1; }
    fi
    [ -f "$d/.config" ] || make -C "$d" defconfig >/dev/null
    echo "$d"

# Build both packages against the project SDK (downloaded into sdks/ if absent).
#   just package-build                  # mediatek/filogic SDK in sdks/
#   just package-build ~/src/my-sdk     # an existing SDK of your choice
package-build sdk="":
    #!/bin/sh
    set -u
    sdk="{{sdk}}"
    [ -n "$sdk" ] || sdk="$(just sdk-download {{target}} | tail -n 1)"
    test -f "$sdk/rules.mk" || { echo "not an OpenWrt SDK: $sdk"; exit 2; }
    sdk=$(cd "$sdk" && pwd -P)   # absolute: the direct make needs it as TOPDIR
    [ -e "$sdk/package/feeds/base/libubox" ] || {
        "$sdk"/scripts/feeds update base >/dev/null 2>&1
        "$sdk"/scripts/feeds install {{feed_libs}} >/dev/null 2>&1; }
    [ -f "$sdk/.config" ] || make -C "$sdk" defconfig >/dev/null
    for pkg in {{packages}}; do
        test -e "$sdk/package/$pkg" || ln -s "$PWD/package/$pkg" "$sdk/package/$pkg"
    done
    # packages linked in after defconfig are invisible to .config until re-run
    for pkg in {{packages}}; do
        grep -q "CONFIG_PACKAGE_$pkg=" "$sdk/.config" || { make -C "$sdk" defconfig >/dev/null; break; }
    done
    # First build: the full in-SDK path compiles and stages libubox/ubus/uci/libmnl.
    # Afterwards the per-package make (scoped, seconds) is enough.
    tgt="$(ls -d "$sdk"/staging_dir/target-* 2>/dev/null | head -1)"
    if [ -z "$tgt" ] || [ ! -f "$tgt/usr/include/libubus.h" ] || [ ! -f "$tgt/usr/include/uci.h" ] \
       || [ ! -f "$tgt/usr/include/libmnl/libmnl.h" ]; then
        echo "first build: bootstrapping SDK staging area (slow, once)"
        make -C "$sdk" package/fritz-guest/compile FAKEROOT=env || exit 1
    fi
    out="{{out_dir}}/$(echo '{{target}}' | tr '/' '-')"
    mkdir -p "$out"
    for pkg in {{packages}}; do
        make -C "$sdk/package/$pkg" clean FAKEROOT=env >/dev/null 2>&1 || true
        # CONFIG_AUTOREMOVE leaves stamps without sources; force a fresh prepare
        rm -rf "$sdk"/build_dir/target-*/"$pkg"-[0-9]*
        # a stale older release in bin/ would otherwise win the name glob below
        rm -f "$sdk"/bin/packages/*/*/"$pkg"-[0-9]*.apk
        make -C "$sdk/package/$pkg" compile FAKEROOT=env TOPDIR="$sdk" || exit 1
        art="$(find "$sdk/bin/packages" -name "$pkg-[0-9]*.apk" 2>/dev/null | head -1)"
        [ -n "$art" ] || { echo "no $pkg .apk produced -- check the build output above"; exit 1; }
        cp -f "$art" "$out/"
        echo "-> $out/$(basename "$art")"
    done

# Remove local build output (never touches /etc or the SDK).
clean:
    rm -rf {{build_dir}} {{out_dir}}

# Remove downloaded SDKs too.
distclean: clean
    rm -rf {{sdk_dir}}
